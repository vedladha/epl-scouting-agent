# Copy to .streamlit/secrets.toml locally, or paste into the Secrets box in
# Streamlit Community Cloud (App settings -> Secrets).

ANTHROPIC_API_KEY = "sk-ant-..."

# Shared passphrase for the deployed demo. Anyone with the URL can spend your
# API credit, so set this before sharing the link. Leave it out entirely to
# run without a gate (fine locally).
APP_PASSWORD = "pick-something-and-send-it-to-your-friend"
